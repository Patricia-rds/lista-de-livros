
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Livros</title>

    <!-- Favicon -->
     <link rel="shortcut icon" href="assets/images/favicon.png" type="image/x-icon">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="assets/style/global.css">
    <link rel="stylesheet" href="assets/style/style.css">
</head>
<body>
    <main id="cabecalho">
        <h1>Lista de Livros</h1>
        <p id="livro-contagem" class="text-center mt-2 fs-5"></p>
    </main>

    <div class="container my-4">
        <div class="row align-items-center g-2">
          <div class="col-md-8">
            <input type="text" id="searchInput" class="form-control" placeholder="Buscar autor ou livro...">
          </div>
          <div class="col-md-4 text-end position-relative">
            <div class="letra-dropdown">
              <button class="btn btn-secondary dropdown-toggle" type="button">
                Filtrar autor
              </button>
              <div class="letras-menu dropdown-menu">
                <!-- Letras serão inseridas aqui via JS -->
              </div>
            </div>
          </div>
        </div>
      </div>

    <div class="accordion" id="accordionFlushExample">
        <!-- O conteúdo dinâmico será inserido aqui -->
    </div>

    <div class="modal fade" id="bookModal" tabindex="-1" aria-labelledby="bookModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="bookModalLabel">Sinopse</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <p id="modal-sinopse"></p>
            </div>
          </div>
        </div>
      </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="assets/js/script.js"></script>
</body>
</html>

main > h1 {
    font-family: 'Gochi Hand', sans-serif;
    text-transform: uppercase;
    font-weight: lighter;
    font-size: 50px;
    text-align: center;
    margin-top: 1.5rem;
}

h2 {
    font-family: 'Iansui', sans-serif;
    text-align: center;
}

.accordion-body {
    background-color: #0b0225;
}

.image-gallery {
  display: flex;
  justify-content: flex-start;
  gap: 10px;
}

.image-gallery img {
  width: 150px;
  height: 225px;
  object-fit: cover;
  border: 2px solid #ffffff50;
  position: relative;
}

.image-container {
  position: relative;
}

.image-name {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: rgba(0, 0, 0, 0.7); /* Fundo escuro para destacar o nome */
  color: white;
  text-align: center;
  padding: 5px 0;
  opacity: 0; /* Inicialmente invisível */
  transition: opacity 0.3s ease; /* Suaviza a transição de visibilidade */
}

.image-container .image-name {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: rgba(0, 0, 0, 0.7); /* Fundo escuro para destacar o nome */
  color: white;
  text-align: center;
  padding: 5px 0;
  opacity: 0; /* Inicialmente invisível */
  transition: opacity 0.3s ease; /* Suaviza a transição */
}

.image-container:hover .image-name {
  opacity: 1; /* Torna o nome visível quando o mouse passa sobre a imagem */
}

.colecao {
  border: 2px solid #fff;
}

.carrossel-container {
  display: flex;
  overflow-x: auto;
  gap: 5px;
  margin: 0 15px 0 0;
}

.carrossel-container img {
  width: 150px;
  height: 225px;
  object-fit: cover;
  border: 2px solid #ffffff50;
}

.accordion-button {
  width: 100%;
}

.form-control {
  max-width: 500px;
  margin-left: 200px;
}

#accordionFlushExample {
  max-width: 1000px;
  margin: 0 auto; /* Centraliza na tela */
  background-color: #f8f9fa; /* Opcional: fundo mais claro */
}

.letra-dropdown {
  display: inline-block;
  position: relative;
  margin-right: 200px;
}

.letra-dropdown:hover .dropdown-menu {
  display: flex;
  flex-wrap: wrap;
  padding: 10px;
  max-height: 200px;
  overflow-y: auto;
}

.letras-menu {
  display: none;
  position: absolute;
  right: 0;
  top: 100%;
  background-color: #fff;
  border: 1px solid #ccc;
  z-index: 999;
  min-width: 100px;
  box-shadow: 0 2px px #1201224f;
  text-align: center;
}

.letras-menu button {
  margin: 1px;
  background-color: #e9ecef;
  border: none;
  border-radius: 4px;
  font-size: 14px;
  cursor: pointer;
  transition: background-color 01s;
}

.letras-menu button:hover {
  background-color: #0b0225;
  color: #fff;
}

.modal-content {
  background-color: #d8d9da;
  color: #000000ea;
}

.modal-header {
  background-color: #0b0225;
  color: white;
}

.btn-close {
  background-color: #d8d9da;
}